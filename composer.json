{
    "name": "emeq/mollie-api",
    "description": "Multi-tenant Laravel SDK rond mollie/mollie-api-php — credential resolver + dual creds (API key + OAuth) + facade.",
    "keywords": [
        "emeq",
        "laravel",
        "mollie",
        "mollie-api",
        "payments",
        "oauth",
        "connect",
        "multi-tenant"
    ],
    "homepage": "https://github.com/yusufkaracaburun/emeq-mollie-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Yusuf Karacaburun",
            "email": "info@emeq.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "mollie/mollie-api-php": "^3.11",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/uid": "^6.4||^7.0||^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^9.0||^10.0||^11.0",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Emeq\\MollieApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emeq\\MollieApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emeq\\MollieApi\\MollieServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
